# Docker Environment Configuration for SQL to MongoDB Migration App

# Application Settings
NODE_ENV=development
PORT=3000

# Database Connection Settings (for Docker containers)
# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=migration_test
MYSQL_USERNAME=testuser
MYSQL_PASSWORD=testpass

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=migration_test
POSTGRES_USERNAME=testuser
POSTGRES_PASSWORD=testpass

# SQL Server
SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=migration_test
SQLSERVER_USERNAME=sa
SQLSERVER_PASSWORD=StrongPass123!

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=migration_test
MONGO_USERNAME=migrator
MONGO_PASSWORD=migratorpass
MONGO_AUTH_SOURCE=migration_test

# Redis (optional)
REDIS_HOST=redis
REDIS_PORT=6379

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
API_RATE_LIMIT=100

# Monitoring (optional)
ENABLE_METRICS=true
METRICS_PORT=9464