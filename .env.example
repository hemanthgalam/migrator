# HTTP port for the API and web console
PORT=3000
# Where the SQLite metadata store and file storage live
DATA_DIR=./.data
# Max pipeline runs executing at once (can also be changed in Settings)
WORKER_CONCURRENCY=2
# First retry delay; doubles on each attempt
RETRY_BASE_MS=2000
# How often the scheduler checks for due pipelines
SCHEDULER_INTERVAL_MS=5000
# Create the demo connections and pipelines on first boot
SEED_DEMO=true
