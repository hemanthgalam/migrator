# Production Environment Configuration
# IMPORTANT: Change all default passwords and secrets before deploying to production!

# Application Settings
NODE_ENV=production
PORT=3000

# MongoDB Production Settings
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=migration_prod
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
MONGO_USERNAME=migrator_prod
MONGO_PASSWORD=CHANGE_THIS_MIGRATOR_PASSWORD_456!
MONGO_AUTH_SOURCE=admin

# Security Settings
JWT_SECRET=CHANGE_THIS_SUPER_SECRET_JWT_KEY_FOR_PRODUCTION_789!
API_RATE_LIMIT=50
ENABLE_CORS=false
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL/TLS Settings
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Logging Settings
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_FILE=/var/log/app/migration.log

# Monitoring Settings
ENABLE_METRICS=true
METRICS_PORT=9464
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD_ABC!

# Performance Settings
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30000
REQUEST_TIMEOUT=300000

# Backup Settings (if applicable)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Email Notifications (optional)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.com
SMTP_PASSWORD=CHANGE_THIS_SMTP_PASSWORD_DEF!
NOTIFICATION_EMAIL=admin@yourdomain.com